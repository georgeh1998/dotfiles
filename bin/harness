#!/bin/bash
# harness: claude -p をフェーズごとに別プロセスで起動する開発ハーネス
#
# bash は決定論の部分(フェーズの進行・回数の上限・commit・成否の判定)だけを持つ。
# 調査・計画・実装・レビュー・解説は claude/skills/ の explore / plan / implement / harness-review / harness-walkthrough スキルに任せる。
#
# ■ 進行状況の持ち方
#   進行状況はすべて claude/tasks/<task>/plan.json に書く。.phase は「次に実行するフェーズ」。
#   drive() のループが .phase を読んでそのフェーズを実行し、各フェーズは終わるときに
#   次の .phase を書き込む。途中で落ちても .phase は書き換わっていないので、
#   同じコマンドを再実行すればそのフェーズからやり直せる。
#   explore と初回 plan は plan.json ができる前なので、explore.md / plan.json の有無で判断する。
#
# ■ .phase の移り変わり
#   explore.md 無し → explore
#   plan.json 無し  → plan(初回)。plan.json を作り .phase = implement
#   implement   → verify       全タスクを 1 つずつ実装して commit したら
#   verify      → review       成功、または --verify なし(skip)
#               → plan         失敗(修正サイクルへ)
#   review      → walkthrough  MUST 指摘が 0 件
#               → plan         MUST 指摘あり(修正サイクルへ)
#   plan(修正)  → implement    失敗ログ / MUST 指摘から修正タスクを作ったら
#   walkthrough → done         解説書を書いたら(上限で止まった場合は stopped)
#
#   - verify ループ: 失敗で plan に戻れるのは MAX_VERIFY - 1 回まで。review から戻ると 0 に戻る
#   - review ループ: MUST で plan に戻れるのは MAX_REVIEW_LOOPS 回まで
#   - 上限に達したら .stop_reason を書いて walkthrough へ進み、最後に stopped になる
#
# ■ commit しない変更(claude/tasks/<task>/local.patch)
#   動作確認用の bypass など、作業ツリーには残すが commit しない変更を local.patch に記録する。
#   - 初回起動時に作業ツリーにある未コミットの変更(ユーザーが入れた bypass など)を保存する
#   - plan が local: true を付けたタスク(claude が入れる bypass)は commit せず、local.patch に足す
#   - 普通のタスクを commit するときは、local.patch の分をインデックスから外してから commit する
#   作業ツリーには残るので、verify もユーザーの確認もその状態で行える。
#   外すときは git apply -R claude/tasks/<task>/local.patch
#
# 詳細は claude/harness/README.md。macOS 標準の bash 3.2 で動くこと(連想配列・mapfile は使わない)

set -o pipefail

MAX_VERIFY=3
MAX_REVIEW_LOOPS=2
FIX_LOG_LINES=200     # 修正 plan に渡す verify ログの行数
FIX_INPUT_BYTES=20000 # 修正 plan に渡す入力の最大バイト数
REVIEW_ASPECTS="correctness security maintainability tests spec"
READONLY_TOOLS="Read,Grep,Glob,Bash"
READONLY_ALLOWED="Read,Grep,Glob,Bash(git log:*),Bash(git diff:*),Bash(git show:*),Bash(ls:*)"
CLAUDE_BIN="${HARNESS_CLAUDE:-claude}" # テストでは fake-claude に差し替える
# jq の前置き: plan.json の最後のサイクルの添字を $c に入れる
LAST_CYCLE='(.cycles | length - 1) as $c'

# オプション
TASK=""
VERIFY_ON=false
STOP_AFTER_PLAN=false

info() { echo "$*"; }
die() {
  echo "ERROR: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: harness [options] <task-name>

/spec で claude/tasks/<task-name>/spec.md を作ってから実行する。
explore → plan → implement → (verify) → review → walkthrough を非対話で回す。
同じコマンドを再実行すると、止まったところから再開する。

options:
  --verify            verify.sh の verify() で完了を判定する
                      (既定は off。review だけが品質ゲートになる)
  --stop-after-plan   初回 plan を作った時点で止める。plan.json を確認・編集してから
                      オプションなしで再実行すると implement から続ける
  -h, --help          このヘルプを表示する

成果物は claude/tasks/<task-name>/ に置かれる(walkthrough.md, review.md, plan.json, logs/)。
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verify) VERIFY_ON=true ;;
      --stop-after-plan) STOP_AFTER_PLAN=true ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        echo "不明なオプション: $1" >&2
        usage >&2
        exit 2
        ;;
      *)
        [[ -z "$TASK" ]] || {
          usage >&2
          exit 2
        }
        TASK=$1
        ;;
    esac
    shift
  done
  [[ -n "$TASK" ]] || {
    usage >&2
    exit 2
  }
  [[ "$TASK" =~ ^[A-Za-z0-9._-]+$ ]] || die "不正な task 名: $TASK"
}

# --- 準備 ------------------------------------------------------------------

# bin/harness がシンボリックリンクでも、dotfiles 内の claude/harness を見つける
resolve_home() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -L "$source" ]]; do
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  HARNESS_HOME="$(cd "$(dirname "$source")/../claude/harness" && pwd)" ||
    die "claude/harness が見つからない"
}

check_deps() {
  local cmd
  for cmd in "$CLAUDE_BIN" jq git; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd コマンドが見つからない"
  done
}

# verify.sh の関数がハーネスの関数を上書きしないよう、サブシェルで source する
check_verify_file() {
  $VERIFY_ON || return 0
  [[ -f "$VERIFY" ]] || die "--verify が指定されたが $VERIFY が無い"
  (
    source "$VERIFY" >/dev/null 2>&1
    declare -F verify >/dev/null
  ) || die "$VERIFY に verify() が定義されていない"
}

# --- plan.json ---------------------------------------------------------------
# 状態はすべて plan.json に置く。更新は tmp に書いてから mv する

# plan_get <jq filter> [jq args...]
plan_get() {
  local f=$1
  shift
  jq -r "$@" "$f" "$PLAN"
}

# plan_update <jq filter> [jq args...]
plan_update() {
  local f=$1
  shift
  jq "$@" "$f" "$PLAN" >"$PLAN.tmp" && mv "$PLAN.tmp" "$PLAN" ||
    die "plan.json の更新に失敗"
}

set_phase() { plan_update '.phase = $p' --arg p "$1"; }
cur_cycle() { plan_get '.cycle'; }

# stop_with <理由> <ログ>: 理由を記録して walkthrough へ進む(書き終えたら stopped になる)
stop_with() {
  plan_update '.stop_reason = $r | .stop_log = $l | .phase = "walkthrough"' --arg r "$1" --arg l "$2"
  info "[harness] 停止: $1"
}

# --- claude 呼び出し ----------------------------------------------------------

# run_claude <label> <model> <budget> <prompt file> -- <claude の追加引数...>
# 出力 JSON を logs/<label>.json に保存する。終了コードと .is_error の両方を見て成否を決める
run_claude() {
  local label=$1 model=$2 budget=$3 prompt=$4 out rc
  shift 4
  [[ "$1" == "--" ]] && shift
  mkdir -p "$LOG_DIR"
  out="$LOG_DIR/$label.json"
  (cd "$ROOT" && "$CLAUDE_BIN" -p --output-format json --no-session-persistence \
    --model "$model" --max-budget-usd "$budget" "$@" <"$prompt") \
    >"$out" 2>"$LOG_DIR/$label.err"
  rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "  claude が異常終了した (exit $rc, label: $label)" >&2
    head -c 500 "$LOG_DIR/$label.err" >&2
    return 1
  fi
  if ! jq -e '.is_error == false' "$out" >/dev/null 2>&1; then
    echo "  claude がエラーを返した (label: $label)" >&2
    jq -r '.result // empty' "$out" 2>/dev/null | head -c 500 >&2
    return 1
  fi
}

# prompt <label> <スキル呼び出し>: プロンプトファイルを書いてそのパスを返す
prompt() {
  mkdir -p "$LOG_DIR"
  echo "$2" >"$LOG_DIR/$1.prompt"
  echo "$LOG_DIR/$1.prompt"
}

# result_to_file <label> <出力先>: claude の最終回答(Markdown)をファイルに書く。空なら失敗
result_to_file() {
  jq -r '.result // empty' "$LOG_DIR/$1.json" >"$2.tmp"
  [[ -n "$(tr -d '[:space:]' <"$2.tmp")" ]] || die "$1: 出力が空"
  mv "$2.tmp" "$2"
}

# --- explore -----------------------------------------------------------------

phase_explore() {
  info "[explore] 調査 (sonnet)"
  run_claude explore sonnet 2 "$(prompt explore "/explore $TASK")" -- \
    --tools "$READONLY_TOOLS" --allowedTools "$READONLY_ALLOWED" ||
    die "explore: claude の実行に失敗"
  result_to_file explore "$EXPLORE"
  info "[explore] 完了: $EXPLORE"
}

# --- plan --------------------------------------------------------------------

# 初回 plan: spec.md と explore.md からタスクを作り、plan.json を新規作成する
plan_initial() {
  local label=cycle1-plan base
  info "[plan] cycle 1: 計画 (opus)"
  run_claude "$label" opus 3 "$(prompt "$label" "/plan $TASK")" -- \
    --tools "$READONLY_TOOLS" --allowedTools "$READONLY_ALLOWED" \
    --json-schema "$(cat "$HARNESS_HOME/plan-schema.json")" ||
    die "plan: claude の実行に失敗"
  jq -e '.structured_output.tasks | length > 0' "$LOG_DIR/$label.json" >/dev/null 2>&1 ||
    die "plan: タスクが返ってこなかった ($LOG_DIR/$label.json)"
  base="$(git -C "$ROOT" rev-parse HEAD)" || die "plan: HEAD を取得できない"
  jq --arg base "$base" '{
      base: $base, phase: "implement", cycle: 1,
      verify_attempts: 0, review_loops: 0,
      next_trigger: null, stop_reason: null, stop_log: null,
      cycles: [{n: 1, trigger: "initial", input_file: null,
        tasks: (.structured_output.tasks | map(. + {status: "pending", sha: null})),
        verify: null, review: null}]
    }' "$LOG_DIR/$label.json" >"$PLAN.tmp" && mv "$PLAN.tmp" "$PLAN" ||
    die "plan: plan.json の生成に失敗"
  info "[plan] 完了: $PLAN ($(plan_get "$LAST_CYCLE"' | .cycles[$c].tasks | length') タスク)"
}

# 修正 plan: logs/cycle<N>-input.md(verify の失敗ログ / review の MUST 指摘)から修正タスクを作る
phase_plan() {
  local n trigger label
  n=$(($(cur_cycle) + 1))
  trigger="$(plan_get '.next_trigger')"
  label="cycle$n-plan"
  [[ -f "$LOG_DIR/cycle$n-input.md" ]] || die "plan: $LOG_DIR/cycle$n-input.md が無い"
  info "[plan] cycle $n: 修正計画 (opus, trigger: $trigger)"
  run_claude "$label" opus 3 "$(prompt "$label" "/plan $TASK fix $n")" -- \
    --tools "$READONLY_TOOLS" --allowedTools "$READONLY_ALLOWED" \
    --json-schema "$(cat "$HARNESS_HOME/plan-schema.json")" ||
    die "plan: claude の実行に失敗"
  if ! jq -e '.structured_output.tasks | length > 0' "$LOG_DIR/$label.json" >/dev/null 2>&1; then
    stop_with "cycle $n の修正 plan が空 (trigger: $trigger)" "$LOG_DIR/$label.json"
    return
  fi
  plan_update '.cycles += [{n: $n, trigger: $t, input_file: $f,
      tasks: ($p[0].structured_output.tasks | map(. + {status: "pending", sha: null})),
      verify: null, review: null}]
    | .cycle = $n | .next_trigger = null | .phase = "implement"' \
    --argjson n "$n" --arg t "$trigger" --arg f "logs/cycle$n-input.md" \
    --slurpfile p "$LOG_DIR/$label.json"
  info "[plan] 完了: cycle $n ($(plan_get "$LAST_CYCLE"' | .cycles[$c].tasks | length') タスク)"
}

# goto_fix <trigger> <src>: 次の修正サイクルの plan に渡す入力を書き、plan へ戻る
#   trigger=verify-fail: src は verify のログ / trigger=review-must: src は review の結合 JSON
goto_fix() {
  local trigger=$1 src=$2 n out
  n=$(($(cur_cycle) + 1))
  out="$LOG_DIR/cycle$n-input.md"
  {
    echo "# cycle $n の修正入力"
    echo
    echo "種別: $trigger"
    echo
    if [[ "$trigger" == verify-fail ]]; then
      echo "## verify の失敗ログ (末尾 $FIX_LOG_LINES 行)"
      echo
      echo '```'
      tail -n "$FIX_LOG_LINES" "$src" | tail -c "$FIX_INPUT_BYTES"
      echo
      echo '```'
    else
      echo "## review の MUST 指摘"
      echo
      jq -r '.findings[] | select(.level == "must")
        | "- [\(.aspect)] \(.file):\(.line)\n  - 問題: \(.problem)\n  - 修正案: \(.suggestion)"' \
        "$src" | head -c "$FIX_INPUT_BYTES"
    fi
    echo
    echo "## これまでの commit"
    echo
    git -C "$ROOT" log --oneline --reverse "$(plan_get '.base')"..HEAD
    echo
    echo "## これまでのサイクル"
    echo
    plan_get '.cycles[] | "- cycle \(.n) (\(.trigger)): " + ([.tasks[].title] | join(" / "))'
  } >"$out.tmp" && mv "$out.tmp" "$out" || die "修正入力 $out の生成に失敗"
  plan_update '.phase = "plan" | .next_trigger = $t' --arg t "$trigger"
}

# --- implement ---------------------------------------------------------------
# 1 タスク = 1 claude 呼び出し = 1 commit。対象は常に最後のサイクル

task_field() {
  plan_get "$LAST_CYCLE"' | .cycles[$c].tasks[] | select(.id == $id) | .[$f]' \
    --argjson id "$1" --arg f "$2"
}

# mark_task <id> <status> <sha(空なら null)>
mark_task() {
  plan_update "$LAST_CYCLE"' | (.cycles[$c].tasks[] | select(.id == $id)) |=
      (.status = $s | .sha = (if $sha == "" then null else $sha end))' \
    --argjson id "$1" --arg s "$2" --arg sha "$3"
}

# claude/tasks(ハーネスの成果物)以外の変更をすべてインデックスに載せる。
# ':(exclude)claude/tasks' の pathspec は、claude/ が gitignore されていると
# 「ignore されたパスを指定した」扱いで exit 1 になるので、add してから外す
stage_all() {
  git -C "$ROOT" add -A && git -C "$ROOT" reset -q -- claude/tasks
}

# HEAD から作業ツリーまでの未コミットの変更(untracked を含む)をすべて local.patch に書く。
# 普通のタスクはすべて commit 済みなので、未コミットの変更 = commit しない変更になる
save_local_patch() {
  stage_all && git -C "$ROOT" diff --cached --binary >"$LOCAL_PATCH.tmp" &&
    git -C "$ROOT" reset -q && mv "$LOCAL_PATCH.tmp" "$LOCAL_PATCH" ||
    die "local.patch の保存に失敗"
}

# 初回だけ: 実行前からある未コミットの変更を commit しない変更として保存する
init_local_patch() {
  [[ -f "$LOCAL_PATCH" ]] && return
  save_local_patch
  if [[ -s "$LOCAL_PATCH" ]]; then
    info "[harness] 未コミットの変更を $LOCAL_PATCH に保存した (作業ツリーに残すが commit しない)"
  fi
}

# local.patch 以外の変更を commit する。変更が無ければ nochange
commit_task() {
  local id=$1 msg sha
  msg="$(task_field "$id" commit_message)"
  stage_all || die "task $id: git add に失敗"
  if [[ -s "$LOCAL_PATCH" ]]; then
    git -C "$ROOT" apply --cached -R "$LOCAL_PATCH" ||
      die "task $id: local.patch と同じ箇所を変更したため、commit する変更と分けられない。手で直してから再開すること"
  fi
  if git -C "$ROOT" diff --cached --quiet; then
    info "  警告: task $id に変更が無い (nochange として続行)"
    mark_task "$id" nochange ""
    return
  fi
  git -C "$ROOT" commit -q -m "$msg" || die "task $id: git commit に失敗"
  sha="$(git -C "$ROOT" rev-parse --short HEAD)"
  mark_task "$id" done "$sha"
  info "  committed $sha: $msg"
}

# 再開時の扱い:
# - 実装の途中で落ちた: 作業ツリーに残った途中の変更は、次に commit するタスクに含まれる
# - commit 直後に落ちた: そのタスクをもう一度実装させる。実装済みなので変更が出ず nochange になる
phase_implement() {
  local n id total label
  n="$(cur_cycle)"
  total="$(plan_get "$LAST_CYCLE"' | .cycles[$c].tasks | length')"
  while :; do
    id="$(plan_get "$LAST_CYCLE"' | [.cycles[$c].tasks[] | select(.status == "pending")][0].id // empty')"
    [[ -z "$id" ]] && break
    info "[implement] cycle $n task $id/$total: $(task_field "$id" title)"
    label="cycle$n-task$id-implement"
    run_claude "$label" sonnet 5 "$(prompt "$label" "/implement $TASK $n $id")" -- \
      --dangerously-skip-permissions ||
      die "task $id: 実装の claude 実行に失敗"
    if [[ "$(task_field "$id" local)" == true ]]; then
      save_local_patch
      mark_task "$id" local ""
      info "  local: commit せず $LOCAL_PATCH に追加"
    else
      commit_task "$id"
    fi
  done
  set_phase verify
}

# --- verify ------------------------------------------------------------------

# verify.sh をサブシェルで source して verify() を実行する。cwd はリポジトリルート
run_verify() {
  mkdir -p "$ARTIFACTS" "$LOG_DIR"
  (
    cd "$ROOT" &&
      export HARNESS_TASK="$TASK" HARNESS_TASK_DIR="$TASK_DIR" HARNESS_ARTIFACTS_DIR="$ARTIFACTS" &&
      source "$VERIFY" && verify
  ) >"$1" 2>&1
}

phase_verify() {
  local n a log ok
  n="$(cur_cycle)"
  if ! $VERIFY_ON; then
    info "[verify] skip (--verify なし)"
    plan_update "$LAST_CYCLE"' | .cycles[$c].verify = {skipped: true} | .phase = "review"'
    return
  fi
  a=$(($(plan_get '.verify_attempts') + 1))
  log="$LOG_DIR/cycle$n-verify.log"
  info "[verify] cycle $n (verify ループ $a/$MAX_VERIFY)"
  if run_verify "$log"; then
    ok=true
    info "  verify OK"
  else
    ok=false
    info "  verify FAILED ($log)"
  fi
  # 回数は結果が出てから数える(verify の途中で落ちた回は数えない)
  plan_update "$LAST_CYCLE"' | .verify_attempts = $a
      | .cycles[$c].verify = {ok: $ok, attempt: $a, log: $l}' \
    --argjson a "$a" --argjson ok "$ok" --arg l "logs/cycle$n-verify.log"
  if $ok; then
    set_phase review
  elif ((a >= MAX_VERIFY)); then
    stop_with "verify ループ $a/$MAX_VERIFY 回目 (cycle $n) で verify が失敗" "$log"
  else
    goto_fix verify-fail "$log"
  fi
}

# --- review ------------------------------------------------------------------
# 観点ごとに claude を並列で起動し、結果を 1 つにまとめて must の件数で判定する

# review_one <aspect> <base> <n>: 結果を reviews/cycle<n>-<aspect>.json に保存する
review_one() {
  local aspect=$1 base=$2 n=$3 label="cycle$3-review-$1" out="$REVIEW_DIR/cycle$3-$1.json"
  run_claude "$label" opus 2 "$(prompt "$label" "/harness-review $TASK $aspect $base")" -- \
    --tools "$READONLY_TOOLS" --allowedTools "$READONLY_ALLOWED" \
    --json-schema "$(cat "$HARNESS_HOME/review-schema.json")" || return 1
  # 構造化出力が無い場合を「MUST 0 件」として扱わない
  jq -e '.structured_output.findings | type == "array"' "$LOG_DIR/$label.json" >/dev/null 2>&1 || {
    echo "  review ($aspect): 構造化出力が無い (label: $label)" >&2
    return 1
  }
  jq --arg a "$aspect" '.structured_output + {aspect: $a}' "$LOG_DIR/$label.json" >"$out.tmp" &&
    mv "$out.tmp" "$out"
}

# render_review_md <結合 JSON> <n>: 人が読む用の Markdown
render_review_md() {
  jq -r --arg n "$2" '
    "# Review (cycle \($n))", "",
    (["must", "should", "nit"][] as $l
      | [.findings[] | select(.level == $l)] as $f
      | "## \($l | ascii_upcase) (\($f | length))", "",
        (if ($f | length) == 0 then "なし" else empty end),
        ($f[] | "- [\(.aspect)] \(.file):\(.line) — \(.problem)\n  - 修正案: \(.suggestion)"),
        ""),
    "## 観点ごとの所見", "",
    (.summaries[] | "- \(.aspect): \(.summary)")' "$1"
}

phase_review() {
  local n base aspect i failed="" combined md must loops
  local pids=() names=() files=()
  n="$(cur_cycle)"
  base="$(plan_get '.base')"
  combined="$REVIEW_DIR/cycle$n.json"
  md="$TASK_DIR/review-cycle$n.md"
  mkdir -p "$REVIEW_DIR"
  info "[review] cycle $n: ${REVIEW_ASPECTS// /, } を並列にレビュー (opus)"

  # 再開時は結果がある観点を飛ばす
  for aspect in $REVIEW_ASPECTS; do
    files+=("$REVIEW_DIR/cycle$n-$aspect.json")
    [[ -f "$REVIEW_DIR/cycle$n-$aspect.json" ]] && continue
    review_one "$aspect" "$base" "$n" &
    pids+=($!)
    names+=("$aspect")
  done
  for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || failed="$failed ${names[$i]}"
  done
  [[ -z "$failed" ]] || die "review: 失敗した観点:$failed (ログ: $LOG_DIR)"

  jq -s --argjson n "$n" '{cycle: $n,
      findings: [.[] | .aspect as $a | .findings[] | . + {aspect: $a}],
      summaries: [.[] | {aspect, summary}]}' "${files[@]}" >"$combined.tmp" &&
    mv "$combined.tmp" "$combined" || die "review: $combined の生成に失敗"
  render_review_md "$combined" "$n" >"$md.tmp" && mv "$md.tmp" "$md" &&
    cp "$md" "$TASK_DIR/review.md" || die "review: $md の生成に失敗"

  plan_update "$LAST_CYCLE"' | .cycles[$c].review = ($r[0].findings | {
      must: map(select(.level == "must")) | length,
      should: map(select(.level == "should")) | length,
      nit: map(select(.level == "nit")) | length,
      file: $file, json: $json})' \
    --slurpfile r "$combined" --arg file "review-cycle$n.md" --arg json "reviews/cycle$n.json"
  must="$(plan_get "$LAST_CYCLE"' | .cycles[$c].review.must')"
  loops="$(plan_get '.review_loops')"
  info "  MUST $must / SHOULD $(plan_get "$LAST_CYCLE"' | .cycles[$c].review.should')" \
    "/ NIT $(plan_get "$LAST_CYCLE"' | .cycles[$c].review.nit') ($md)"

  if ((must == 0)); then
    set_phase walkthrough
  elif ((loops >= MAX_REVIEW_LOOPS)); then
    stop_with "review ループ: $loops/$MAX_REVIEW_LOOPS 回やり直した後も MUST 指摘が $must 件 (cycle $n)" "$md"
  else
    # 先に回数を増やす(goto_fix の前に落ちても、多めに数えるだけで無限ループにはならない)
    plan_update '.review_loops += 1 | .verify_attempts = 0'
    goto_fix review-must "$combined"
  fi
}

# --- walkthrough -------------------------------------------------------------

phase_walkthrough() {
  info "[walkthrough] 解説書を生成 (sonnet)"
  run_claude walkthrough sonnet 2 "$(prompt walkthrough "/harness-walkthrough $TASK")" -- \
    --tools "$READONLY_TOOLS" --allowedTools "$READONLY_ALLOWED" ||
    die "walkthrough: claude の実行に失敗"
  result_to_file walkthrough "$WALKTHROUGH"
  info "[walkthrough] 完了: $WALKTHROUGH"
  if [[ "$(plan_get '.stop_reason')" == null ]]; then set_phase done; else set_phase stopped; fi
}

# --- 結果表示 ------------------------------------------------------------------

report_done() {
  local verify
  verify="$(plan_get "$LAST_CYCLE"' | if .cycles[$c].verify.skipped then "skip" else "OK" end')"
  info "[harness] 完了: $(plan_get '.cycles | length') サイクル, verify $verify, MUST 0" \
    "/ SHOULD $(plan_get "$LAST_CYCLE"' | .cycles[$c].review.should // 0')" \
    "/ NIT $(plan_get "$LAST_CYCLE"' | .cycles[$c].review.nit // 0')"
  info "  解説書: $WALKTHROUGH"
  info "  review: $TASK_DIR/review.md"
  report_local_patch
}

report_stopped() {
  {
    echo "[harness] 停止中: $(plan_get '.stop_reason')"
    echo "  ログ: $(plan_get '.stop_log // "-"')"
    echo "  解説書: $WALKTHROUGH"
    echo "  手で直して続けるには plan.json の phase と回数を戻す (claude/harness/README.md の「再開」)"
    report_local_patch
  } >&2
  exit 1
}

report_local_patch() {
  [[ -s "$LOCAL_PATCH" ]] || return 0
  echo "  commit していない変更が作業ツリーに残っている: $LOCAL_PATCH"
  echo "    外すとき: git apply -R $LOCAL_PATCH"
}

# --- メインループ ----------------------------------------------------------------

# 各フェーズはサブシェルで実行する。die で落ちても状態は plan.json に残っているので、
# 同じコマンドの再実行でそのフェーズからやり直せる
run_phase() {
  ("$1") || {
    echo "[harness] $1 で中断 (直してから harness $TASK で再開)" >&2
    exit 1
  }
}

drive() {
  [[ -f "$SPEC" ]] || die "$SPEC が無い。先に /spec で spec.md を作ること"
  run_phase init_local_patch
  [[ -f "$EXPLORE" ]] || run_phase phase_explore
  if [[ ! -f "$PLAN" ]]; then
    run_phase plan_initial
  elif $STOP_AFTER_PLAN; then
    info "[harness] plan.json は作成済み (--stop-after-plan なので何もしない)"
    return 0
  fi
  if $STOP_AFTER_PLAN; then
    info "[harness] --stop-after-plan: plan で停止した"
    info "  $PLAN を確認・編集してから harness $TASK で implement から続ける"
    return 0
  fi
  while :; do
    case "$(plan_get '.phase')" in
      plan) run_phase phase_plan ;;
      implement) run_phase phase_implement ;;
      verify) run_phase phase_verify ;;
      review) run_phase phase_review ;;
      walkthrough) run_phase phase_walkthrough ;;
      stopped) report_stopped ;;
      done)
        report_done
        return 0
        ;;
      *) die "plan.json の phase が不正: $(plan_get '.phase')" ;;
    esac
  done
}

main() {
  parse_args "$@"
  resolve_home
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "git リポジトリの中で実行すること"
  TASK_DIR="$ROOT/claude/tasks/$TASK"
  LOG_DIR="$TASK_DIR/logs"
  REVIEW_DIR="$TASK_DIR/reviews"
  ARTIFACTS="$TASK_DIR/artifacts"
  SPEC="$TASK_DIR/spec.md"
  EXPLORE="$TASK_DIR/explore.md"
  PLAN="$TASK_DIR/plan.json"
  VERIFY="$TASK_DIR/verify.sh"
  LOCAL_PATCH="$TASK_DIR/local.patch"
  WALKTHROUGH="$TASK_DIR/walkthrough.md"
  check_deps
  check_verify_file
  drive
}

main "$@"
